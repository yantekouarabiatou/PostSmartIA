APP_NAME="PostSmart IA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ton-backend.railway.app

# URL du frontend (Next.js) — utilisée par Sanctum CORS et les redirections mail
FRONTEND_URL=https://ton-frontend.vercel.app

# ─── Base de données (Railway MySQL) ────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Certificat TLS Railway — obligatoire si Railway impose SSL sur la connexion MySQL
# Valeur Railway : /etc/ssl/certs/ca-certificates.crt
MYSQL_ATTR_SSL_CA=

# ─── Provider IA actif ───────────────────────────────────────────────────────
# Valeurs possibles : gemini | mistral | groq | claude
# En production La Poste → AI_PROVIDER=mistral (OVHcloud France, souveraineté)
AI_PROVIDER=gemini

# ─── Gemini (Google) ─────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ─── Mistral AI — provider souverain recommandé production La Poste ──────────
# Déployé sur OVHcloud France : données hors CLOUD Act américain
# Doc : https://docs.mistral.ai/api/
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# ─── Groq (fallback 1 — très rapide) ─────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ─── Claude / Anthropic (fallback 2) ─────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6-20251001

# ─── IMAP — boîte mail à surveiller ─────────────────────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_USERNAME=
IMAP_PASSWORD=

# ─── SMTP sortant (Resend recommandé) ───────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@votredomaine.fr
MAIL_FROM_NAME="PostSmart IA"

# ─── Session & Cache ─────────────────────────────────────────────────────────
# Sur Railway sans Redis : conserver 'cookie' pour session et 'array' pour cache
SESSION_DRIVER=cookie
CACHE_STORE=array

# ─── Queue ───────────────────────────────────────────────────────────────────
# 'sync' exécute les jobs de manière synchrone (sans worker séparé)
# Passer à 'database' ou 'redis' si vous configurez un worker Railway
QUEUE_CONNECTION=sync

# ─── Logs ─────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stderr
LOG_LEVEL=error

# ─── Sanctum (CORS) ──────────────────────────────────────────────────────────
# Domaines autorisés à envoyer des cookies Sanctum (séparer par virgule)
SANCTUM_STATEFUL_DOMAINS=ton-frontend.vercel.app
